# ---- 配图（原有）----
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

PORT=3001

# ---- LLM ----
# 用哪一家都可以。下面每行只需要填你会用的那一行，
# 然后用 LLM_PROVIDER 指定默认厂商（或在命令行 --provider 覆盖）。
# 查看当前就绪情况：npx tsx pipeline/design-lesson.ts --list
#
# 留空 LLM_PROVIDER 时的回退顺序：
#   有 OPENAI_API_KEY → 用 openai；否则有 GEMINI_API_KEY → 用 gemini

# 通用：默认走哪个厂商，可选值见下方注释
# LLM_PROVIDER=gemini:gemini-2.5-flash

# OpenAI 兼容协议（一个适配器覆盖下面所有厂商，只是 baseURL 不同）
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=            # 中文教学设计性价比高，推荐阶段①用
# QWEN_API_KEY=                # 通义千问（也可用 DASHSCOPE_API_KEY）
# MOONSHOT_API_KEY=            # Kimi
# MINIMAX_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Gemini —— 原生 responseSchema，结构化输出最稳，推荐阶段①②都用它
# GEMINI_API_KEY=

# Claude —— 无 JSON mode，用 tool use 强制结构化
# ANTHROPIC_API_KEY=

# Ollama —— 本地离线，零成本。适合先跑通链路和批量粗筛，
#          但 JSON 纪律和 Manim 正确率明显低于云端大模型
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# 任意自定义 OpenAI 兼容端点
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ---- 教学视频管线 ----
# Manim 场景代码的渲染自愈循环会调用它；默认用项目内 venv
# MANIM_BIN=pipeline/manim-venv/bin/manim
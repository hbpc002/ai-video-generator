{
  "name": "ai-video-generator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "video"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "install:all": "npm install",
    "gen": "npx tsx generate.ts",
    "studio": "npm run start --workspace=video",
    "lesson:design": "npx tsx pipeline/design-lesson.ts",
    "lesson:code": "npx tsx pipeline/gen-manim.ts",
    "lesson:timeline": "python3 pipeline/edge_timeline.py",
    "lesson:manim": "python3 pipeline/render_manim.py",
    "lesson:props": "npx tsx pipeline/build-lesson-props.ts",
    "lesson:render": "npm run render --workspace=video -- LessonVideo"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.409",
    "@remotion/renderer": "^4.0.409",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.3",
    "yargs": "^18.0.0"
  }
}
